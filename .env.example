# Supabase — بدونها يعمل الموقع على البيانات المحلية في data/products.ts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# مفتاح الخدمة: على الخادم فقط. يتخطى سياسات الصفوف، فلا يوضع في NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# محافظ التحويل — ضع رقماً واحداً على الأقل ليظهر خيار "تحويل إلى محفظة".
# بدونها يبقى الدفع عند الاستلام وحده مفعّلاً.
NEXT_PUBLIC_ZAINCASH_NUMBER=
NEXT_PUBLIC_FASTPAY_NUMBER=

# رابط الموقع
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# اجعلها 1 بعد وضع public/models/tshirt.glb
NEXT_PUBLIC_USE_GLB=0
